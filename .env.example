# ------------------------------------------------------------------
# ABYSS.IO server configuration - copy to server/.env and edit.
# Real environment variables always take precedence over this file.
# This file is NEVER served to the browser: the server blocks /server/**.
# ------------------------------------------------------------------

# Administrator gate for /admin  (REQUIRED before going public)
ABYSS_ADMIN_USER=your_admin_name

# Preferred: generate this line with
#   python server/hash_admin_password.py --write-env
# The generator writes an Argon2id PHC hash:
#   $argon2id$v=19$m=65536,t=3,p=4$<salt>$<hash>
# The legacy scrypt$N$r$p$salt_hex$hash_hex format is still accepted.
ABYSS_ADMIN_PASSWORD_HASH=

# Alternative to the hash line (only use one). Minimum 16 characters. The
# plain value is hashed in memory at startup and is never written to the
# database. Prefer the Argon2id hash line above.
# ABYSS_ADMIN_PASSWORD=use-a-long-unique-password

# How long an admin sign-in may last in total, in hours.
ABYSS_ADMIN_SESSION_HOURS=8

# How long an idle admin session survives, in minutes.
ABYSS_ADMIN_IDLE_MINUTES=60

# Failed sign-ins before a temporary lockout (minimum 3).
ABYSS_ADMIN_MAX_FAILS=5

# First lockout length in minutes. Repeat offences double it up to one hour.
ABYSS_ADMIN_LOCK_MINUTES=15

# Optional extra layer: only these client IPs / IPv4 CIDR blocks may reach
# /admin and /api/admin. Everything else gets a plain 404. Comma separated.
# Example: 203.0.113.7,198.51.100.0/24
ABYSS_ADMIN_ALLOW_IPS=

# Set to 1 to tie each admin session to the IP that signed in. Useful on a
# fixed connection; leave 0 for mobile networks that change IP.
ABYSS_ADMIN_BIND_IP=0

# Network
# 127.0.0.1 = this PC only. Use 0.0.0.0 when a reverse proxy / tunnel
# forwards traffic to this process.
ABYSS_HOST=127.0.0.1
ABYSS_PORT=8730

# Set to 1 only when a trusted reverse proxy (Cloudflare Tunnel, nginx,
# Caddy) terminates HTTPS. The server then uses CF-Connecting-IP /
# X-Forwarded-For for rate limits and the allowlist, and X-Forwarded-Proto
# for the Secure cookie flag. Never enable it when clients can reach the
# process directly, or they could spoof those headers.
ABYSS_TRUST_PROXY=0

# Cookie Secure flag: auto (HTTPS only), always, or never.
# Behind an HTTPS tunnel set ABYSS_TRUST_PROXY=1 and keep auto.
ABYSS_COOKIE_SECURE=auto

# A registered player counts as online if seen in this many seconds.
ABYSS_ONLINE_WINDOW=60

# Optional: point the database somewhere else (default: server/data).
# ABYSS_DATA_DIR=C:\abyss-data
